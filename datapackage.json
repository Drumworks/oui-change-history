      "title": "Creative Commons Attribution 4.0 International"
    }
  ],
  "contributors": [
    {
      "title": "ssid.ai",
      "path": "https://ssid.ai",
      "role": "publisher"
    }
  ],
  "keywords": [
    "mac address",
    "oui",
    "ieee",
    "device identification",
    "provenance",
    "open data"
  ],
  "resources": [
    {
      "profile": "tabular-data-resource",
      "name": "oui-changes",
      "path": "oui-changes.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "encoding": "utf-8",
      "dialect": {
        "delimiter": ",",
        "lineTerminator": "\n",
        "header": true
      },
      "schema": {
        "fields": [
          {
            "name": "oui_prefix",
            "type": "string"
          },
          {
            "name": "change_type",
            "type": "string"
          },
          {
            "name": "observed_at",
            "type": "datetime"
          },
          {
            "name": "previous_org",
            "type": "string"
          },
          {
            "name": "current_org",
            "type": "string"
          },
          {
            "name": "source_url",
            "type": "string"
          },
          {
            "name": "source_archive_url",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "observations",
      "path": "observations.csv",
      "format": "csv",
      "mediatype": "text/csv"
    },
    {
      "name": "known-duplicate-prefixes",
      "path": "known-duplicate-prefixes.csv",
      "format": "csv",
      "mediatype": "text/csv"
